{
   "name": "@stencil-hq/slab",
   "version": "0.1.0",
   "description": "Slab compiler, static renderer, and code-generation CLI — WASM-bundled, no Rust toolchain required",
   "keywords": [
      "slab",
      "ui",
      "design-language",
      "wasm",
      "compiler",
      "cli"
   ],
   "type": "module",
   "license": "MIT",
   "homepage": "https://github.com/stencil-hq/slab",
   "bugs": "https://github.com/stencil-hq/slab/issues",
   "repository": {
      "type": "git",
      "url": "https://github.com/stencil-hq/slab",
      "directory": "packages/slab"
   },
   "publishConfig": {
      "access": "public"
   },
   "bin": {
      "slab": "./bin/slab.js"
   },
   "files": [
      "bin",
      "dist",
      "src",
      "wasm",
      "LICENSE",
      "LICENSE-Inter-OFL.txt",
      "LICENSE-JetBrainsMono-OFL.txt",
      "README.md"
   ],
   "engines": {
      "node": ">=20"
   },
   "exports": {
      ".": {
         "types": "./dist/cli.d.ts",
         "default": "./dist/cli.js"
      },
      "./vite": {
         "types": "./dist/vite.d.ts",
         "bun": "./src/vite.ts",
         "default": "./dist/vite.js"
      },
      "./bun": {
         "types": "./dist/bun.d.ts",
         "bun": "./src/bun.ts",
         "default": "./dist/bun.js"
      }
   },
   "peerDependencies": {
      "@stencil-hq/wslab": "workspace:*",
      "vite": ">=5"
   },
   "peerDependenciesMeta": {
      "@stencil-hq/wslab": {
         "optional": true
      },
      "vite": {
         "optional": true
      }
   },
   "devDependencies": {
      "@types/bun": "^1.2.0",
      "vite": "^7.0.0"
   }
}
