{
   "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
   "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 3,
      "lineWidth": 100
   },
   "javascript": {
      "formatter": {
         "quoteStyle": "single"
      }
   },
   "linter": {
      "enabled": true,
      "rules": {
         "preset": "recommended",
         "style": {
            "useNamingConvention": "off"
         },
         "suspicious": {
            "noConsole": "off"
         }
      }
   },
   "files": {
      "includes": [
         "clients/**",
         "tools/**",
         "packages/**",
         "scripts/**",
         "site/**",
         "!**/dist",
         "!**/wasm",
         "!**/.venv",
         "!**/.build",
         "!packages/slab/bin"
      ]
   }
}
