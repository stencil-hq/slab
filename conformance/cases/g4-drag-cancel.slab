// Gesture conformance: release-away, blur, and close each terminate a drag exactly once.
row key=board w=300 h=64 gap=40 {
  box key=source w=80 h=64 act=activate drag=drag-start drag-update=drag-update drag-end=drag-end bg=#314158 {
    when dragging { bg=#7660a8 }
    text "source" color=#ffffff size=14
  }
  box key=target w=100 h=64 drop=dropped bg=#234738 {
    when drop { bg=#3d8a62 }
    text "target" color=#ffffff size=14
  }
}
