  row w=fill h=24 gap=24 align=center {
    text "👍 ready" color=#3ddc84 nowrap
    text "🇨🇭 Zürich" color=#ffb454 nowrap
  }
  text "café · 東京 · 中文" size=12 nowrap
  text "text presentation: 👍︎" size=12 color=#8b949e nowrap
}
