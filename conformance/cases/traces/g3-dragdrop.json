{
  "doc": "g3-dragdrop",
  "env": { "vw": 300, "vh": 96, "client": "web", "dark": false, "coarse": false },
  "steps": [
    { "t": 0, "event": { "type": "pointer-down", "x": 20, "y": 20, "button": 0, "clicks": 1 } },
    { "t": 1, "event": { "type": "pointer-move", "x": 22, "y": 20, "dx": 2, "dy": 0 } },
    { "t": 2, "event": { "type": "pointer-move", "x": 28, "y": 20, "dx": 6, "dy": 0 } },
    { "t": 3 },
    { "t": 4, "event": { "type": "pointer-move", "x": 150, "y": 20, "dx": 122, "dy": 0, "mods": ["alt"] } },
    { "t": 5 },
    { "t": 6, "event": { "type": "pointer-up", "x": 150, "y": 20, "button": 0, "mods": ["alt"] } },
    { "t": 7 }
  ],
  "expect": {
    "signals": [
      { "name": "source-move", "text": "", "item": "" },
      { "name": "source-move", "text": "", "item": "" },
      { "name": "drag-start", "text": "", "item": "" },
      { "name": "drag-update", "text": "", "item": "" },
      { "name": "source-move", "text": "", "item": "" },
      { "name": "drag-update", "text": "", "item": "" },
      { "name": "source-up", "text": "", "item": "" },
      { "name": "dropped", "text": "", "item": "" },
      { "name": "drag-end", "text": "", "item": "" }
    ],
    "focus_key": "board/source"
  }
}
