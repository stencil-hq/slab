{
  "version": "1.0.0",
  "comparison": {
    "frame_json": "byte-exact against expected/<name>.frame.json from slab-kernel on BOTH targets: native via `slab conformance`, WebAssembly via `bun tools/conformance-wasm.ts`",
    "floats": "round-half-even to 3 decimals, -0 -> 0, formatted by slab-kernel `dumpjson` — hosts never format numbers",
    "metrics": "SLIR FONT tables (vendored Inter / JetBrains Mono), advance(gid)*size/upem + tracking, gid 0 -> default_advance; NOT the 0.5 Helvetica AFM table"
  },
  "notes": {
    "t": "animation clock in ms; defaults to 0 and drives kernel motion sampling",
    "states_prev+state_age": "transition sampling inputs: solve states_prev at t=0, flip to states at t=0, then sample at state_age ms",
    "theme": "runtime theme name; defaults to the empty authored base and is applied before the first frame",
    "set": "runtime param overrides applied before the first frame; list params accept JSON arrays of schema-shaped objects",
    "client": "renderer class driving `when` Client conditions: web|gpu|tui|svg|png; TUI cases also freeze plain `cells` output plus an `attrs` attribute plane (expected/<name>.attrs.txt: per-row runs of explicit fg/bg/strike cell state) so SGR-only regressions are caught",
    "caps": "kind=caps cases freeze the degradation report as expected/<name>.caps.txt instead of frame.json: TUI `cells` grid diagnostics first, then one `chart <level> <feature>: <note>` line per used support.toml feature the client degrades/drops. The single slab-kernel `capability` scan is exercised natively by `slab conformance` and through WebAssembly by `bun tools/conformance-wasm.ts`; outputs must agree byte-identically. GPU-only render-time notes (e.g. cap-gradient-stroke) need a GPU and stay out of conformance; d3 asserts the chart level instead."
  },
