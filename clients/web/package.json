{
   "name": "@stencil-hq/wslab",
   "version": "0.1.0",
   "type": "module",
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "https://github.com/stencil-hq/slab"
   },
   "publishConfig": {
      "access": "public"
   },
   "files": [
      "*.ts",
      "dist",
      "wasm"
   ],
   "main": "index.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "bun": "./index.ts",
         "default": "./dist/index.js"
      },
      "./*.ts": {
         "types": "./dist/*.d.ts",
         "bun": "./*.ts",
         "default": "./dist/*.js"
      }
   }
}
