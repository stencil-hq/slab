{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "slab",
      "camelcase": "Slab",
      "scope": "source.slab",
      "path": ".",
      "file-types": ["slab"],
      "injection-regex": "^slab$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Slab design language",
    "links": {
      "repository": "https://example.invalid/tree-sitter-slab"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
